<Window x:Class="DigitalBattleMap.Views.HexCutoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Add hex tile"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontSize="15">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!--Image with hex overlay-->
        <Border BorderThickness="1" BorderBrush="Gray" Width="500" Height="500"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas x:Name="ImageCanvas" Width="500" Height="500" ClipToBounds="True"
                    Cursor="Cross" Background="Transparent"
                    MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown">
                <Image Source="{Binding SourceImage}"
                       Width="{Binding DisplayWidth}"
                       Height="{Binding DisplayHeight}"
                       Canvas.Left="{Binding DisplayOffsetX}"
                       Canvas.Top="{Binding DisplayOffsetY}"
                       Stretch="Fill"/>
                <Polygon Points="{Binding OverlayPoints}"
                         Stroke="Red" StrokeThickness="2"
                         Fill="#22FF0000"/>
            </Canvas>
        </Border>

        <!--Controls-->
        <Grid Grid.Column="1" Margin="12 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Label Content="Tile name" Padding="0 0 0 2"/>
            <TextBox Grid.Row="1" Text="{Binding TileName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 12"/>

            <Label Grid.Row="2" Content="Hex radius (px)" Padding="0 0 0 2"/>
            <Slider Grid.Row="3" Minimum="10" Maximum="{Binding MaxRadius}"
                    Value="{Binding HexRadius, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 0 2"/>
            <TextBox Grid.Row="4" Text="{Binding HexRadius, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                     Margin="0 0 0 12"/>

            <Label Grid.Row="5" Content="Center X (px)" Padding="0 0 0 2"/>
            <TextBox Grid.Row="6" Text="{Binding HexCenterX, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                     Margin="0 0 0 6"/>

            <Label Grid.Row="7" Content="Center Y (px)" Padding="0 0 0 2"/>
            <TextBox Grid.Row="8" Text="{Binding HexCenterY, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/>

            <Button Grid.Row="9" Content="Save" Margin="0 12 0 6"
                    Command="{Binding ConfirmCommand}" IsDefault="True">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:CallMethodAction MethodName="Close"
                            TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Grid.Row="10" Content="Cancel" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
