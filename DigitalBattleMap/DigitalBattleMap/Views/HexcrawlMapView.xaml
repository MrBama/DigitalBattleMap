<UserControl x:Class="DigitalBattleMap.Views.HexcrawlMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uielements="clr-namespace:DigitalBattleMap.UIElements"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1440">
    <Grid>
        <uielements:HexMapCanvas ViewModel="{Binding}"
                               ShowFog="{Binding DataContext.IsHexPlayMode, RelativeSource={RelativeSource AncestorType=Window}}"
                               FogExploreCommand="{Binding DataContext.HexcrawlPlay.ExploreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               FogCoverCommand="{Binding DataContext.HexcrawlPlay.CoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               IsTokenMode="{Binding DataContext.HexcrawlPlay.IsTokenMode, RelativeSource={RelativeSource AncestorType=Window}}"
                               PlaceTokenCommand="{Binding DataContext.HexcrawlPlay.PlaceTokenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               SelectCellCommand="{Binding SelectCellCommand}"/>
    </Grid>
</UserControl>
