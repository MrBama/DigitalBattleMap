<UserControl x:Class="DigitalBattleMap.Views.HexcrawlPlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uielements="clr-namespace:DigitalBattleMap.UIElements"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="480"
             Background="White"
             FontSize="17">
    <UserControl.Resources>
        <uielements:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <uielements:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" IsInverted="True"/>
    </UserControl.Resources>

    <StackPanel>

        <!--Fog controls-->
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox VerticalContentAlignment="Center"
                      IsChecked="{Binding IncludeNeighbors}"
                      Content="Include neighbors"
                      Margin="0 0 12 0"/>

            <Button Grid.Column="2" Content="Reset fog"
                    Command="{Binding ResetFogCommand}"/>
        </Grid>

        <!--Mode toggle: single toggle button, off = fog mode, on = token mode-->
        <ToggleButton IsChecked="{Binding IsTokenMode}"
                      Content="Token placement mode"
                      HorizontalAlignment="Left"
                      Margin="0 0 0 4"/>

        <!--Context-sensitive hint-->
        <TextBlock Text="Left-click: explore  |  Right-click: cover"
                   Visibility="{Binding IsTokenMode, Converter={StaticResource InvertedBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                   Foreground="Gray" FontSize="12" Margin="0 0 0 4"/>
        <TextBlock Text="Left-click: place party token"
                   Visibility="{Binding IsTokenMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                   Foreground="Gray" FontSize="12" Margin="0 0 0 8"/>

        <!--Ping mode-->
        <Separator Margin="0 4 0 8"/>
        <ToggleButton Content="Ping mode"
                      IsChecked="{Binding IsPingMode}"
                      HorizontalAlignment="Left"
                      Margin="0 0 0 4"/>
        <TextBlock Text="Left-click and drag to draw a ping circle"
                   Visibility="{Binding IsPingMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                   Foreground="Gray" FontSize="12" Margin="0 0 0 4"/>

        <!--Place names toggle-->
        <Separator Margin="0 4 0 8"/>
        <CheckBox Content="Reveal names on explore"
                  IsChecked="{Binding RevealNamesOnExplore}"
                  Margin="0 0 0 8"/>

        <!--Party token section-->
        <Separator Margin="0 4 0 8"/>
        <TextBlock Text="Party token" FontWeight="SemiBold" Margin="0 0 0 6"/>

        <Grid Margin="0 0 0 6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Load image"
                    Command="{Binding LoadTokenImageCommand}"
                    HorizontalAlignment="Left"/>

            <Button Grid.Column="1" Content="Clear token"
                    Command="{Binding ClearTokenCommand}"
                    Margin="6 0 0 0"/>
        </Grid>

        <!--Token image preview (empty when no image is loaded)-->
        <Image Source="{Binding Map.PartyTokenImage}"
               Width="48" Height="48"
               HorizontalAlignment="Left"
               Stretch="UniformToFill"
               Margin="0 0 0 4">
            <Image.Clip>
                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
            </Image.Clip>
        </Image>

    </StackPanel>
</UserControl>
