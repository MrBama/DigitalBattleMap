<UserControl x:Class="DigitalBattleMap.Views.HexcrawlPlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uielements="clr-namespace:DigitalBattleMap.UIElements"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="480"
             Background="White"
             FontSize="17">
    <UserControl.Resources>
        <uielements:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <uielements:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" IsInverted="True"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

        <!--Fog controls-->
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox VerticalContentAlignment="Center"
                      IsChecked="{Binding IncludeNeighbors}"
                      Content="Include neighbors"
                      Margin="0 0 12 0"/>

            <Button Grid.Column="2" Content="Reset fog"
                    Command="{Binding ResetFogCommand}"
                    ToolTip="Cover the whole map with fog and hide all revealed place names"/>
        </Grid>

        <!--Mode toggle: single toggle button, off = fog mode, on = token mode-->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
            <ToggleButton IsChecked="{Binding IsTokenMode}"
                          Content="Token placement mode"/>
            <!--Party lost: token moves are tracked for the DM only; players keep seeing the last known spot-->
            <ToggleButton IsChecked="{Binding IsPartyLost}"
                          Content="Party lost"
                          ToolTip="Players keep seeing the token on its current hex and nothing new is revealed. Token clicks only move the actual position (dashed red marker, visible to you). Turn off to move the token there and reveal it."
                          Margin="6 0 0 0"/>
        </StackPanel>

        <!--Context-sensitive hint-->
        <TextBlock Text="Left-click: explore  |  Right-click: cover"
                   Visibility="{Binding IsTokenMode, Converter={StaticResource InvertedBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                   Foreground="Gray" FontSize="12" Margin="0 0 0 4"/>
        <TextBlock Text="Left-click: place party token"
                   Visibility="{Binding IsTokenMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                   Foreground="Gray" FontSize="12" Margin="0 0 0 4"/>
        <TextBlock Text="Party lost: token clicks move the actual position (only you see it)"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsPartyLost, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"
                   Foreground="Firebrick" FontSize="12" Margin="0 0 0 8"/>

        <!--Ping mode-->
        <Separator Margin="0 4 0 8"/>
        <ToggleButton Content="Ping mode"
                      IsChecked="{Binding IsPingMode}"
                      HorizontalAlignment="Left"
                      Margin="0 0 0 4"/>
        <TextBlock Text="Left-click and drag to draw a ping circle"
                   Visibility="{Binding IsPingMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"
                   Foreground="Gray" FontSize="12" Margin="0 0 0 4"/>

        <!--Party token section-->
        <Separator Margin="0 4 0 8"/>
        <TextBlock Text="Party token" FontWeight="SemiBold" Margin="0 0 0 6"/>

        <Grid Margin="0 0 0 6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Load image"
                    Command="{Binding LoadTokenImageCommand}"
                    HorizontalAlignment="Left"/>

            <Button Grid.Column="1" Content="Clear image"
                    Command="{Binding ClearTokenImageCommand}"
                    HorizontalAlignment="Left"
                    Margin="6 0 0 0"/>

            <Button Grid.Column="2" Content="Clear token"
                    Command="{Binding ClearTokenCommand}"
                    Margin="6 0 0 0"/>
        </Grid>

        <!--Token image preview (empty when no image is loaded)-->
        <Image Source="{Binding Map.PartyTokenImage}"
               Width="48" Height="48"
               HorizontalAlignment="Left"
               Stretch="UniformToFill"
               Margin="0 0 0 4">
            <Image.Clip>
                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
            </Image.Clip>
        </Image>

        <!--Day tracker: reminders only, nothing is rolled-->
        <Separator Margin="0 4 0 4"/>
        <Expander IsExpanded="True" DataContext="{Binding Tracker}">
            <Expander.Header>
                <TextBlock Text="{Binding DayTitle}" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel Margin="4 4 0 4">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                    <Button Content="Next phase" Command="{Binding NextPhaseCommand}" Padding="6 0"/>
                    <Button Content="New day" Command="{Binding NewDayCommand}" Margin="6 0 0 0" Padding="6 0"/>
                    <Button Content="Previous day" Command="{Binding PreviousDayCommand}" Margin="6 0 0 0" Padding="6 0"
                            ToolTip="Undo New day: go back to the last completed day (the token is not moved)"/>
                </StackPanel>

                <!--Exploring hours-->
                <Grid Margin="0 0 0 4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding HoursText}" VerticalAlignment="Center" FontSize="15" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="−1" Command="{Binding RemoveHourCommand}" Width="30" Margin="4 0 0 0"
                            ToolTip="Correct: remove one exploring hour"/>
                    <Button Grid.Column="2" Content="+1" Command="{Binding AddHourCommand}" Width="30" Margin="4 0 0 0"
                            ToolTip="Correct: add one exploring hour"/>
                    <Button Grid.Column="3" Content="Search (1 h)" Command="{Binding SearchCommand}" Margin="4 0 0 0" Padding="4 0"
                            ToolTip="Named hexes only: mark the party's hex as searched and spend 1 hour"/>
                </Grid>
                <TextBlock Text="{Binding TodayRouteText}" FontSize="13" Foreground="Gray" TextWrapping="Wrap" Margin="0 0 0 4"/>
                <TextBlock Text="{Binding ForcedMarchText}" Foreground="Firebrick" FontSize="13" TextWrapping="Wrap"
                           Visibility="{Binding IsForcedMarch, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"
                           Margin="0 0 0 4"/>

                <!--Phase checklist (resets on phase change)-->
                <ItemsControl ItemsSource="{Binding Checklist}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0 2 0 0" VerticalContentAlignment="Top">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <!--Party hex card: the party's actual hex (lost marker while lost)-->
        <Separator Margin="0 4 0 4"/>
        <Expander IsExpanded="True" DataContext="{Binding Tracker}">
            <Expander.Header>
                <TextBlock Text="Party hex" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel Margin="4 4 0 4">
                <TextBlock Text="{Binding PartyHexTitle}" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="Actual position (party is lost)" Foreground="Firebrick" FontSize="12"
                           Visibility="{Binding ShowsLostPosition, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"/>
                <StackPanel Visibility="{Binding HasPartyHex, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
                    <TextBlock Text="{Binding TerrainText}" FontSize="14" TextWrapping="Wrap" Margin="0 2 0 0"/>
                    <TextBlock Text="{Binding NavigationText}" FontSize="14" TextWrapping="Wrap" Margin="0 2 0 0"/>
                    <TextBlock Text="{Binding TrailblazedText}" FontSize="14" TextWrapping="Wrap" Margin="0 2 0 0"
                               ToolTip="Adjacent hexes the party has already visited (from the history and today's route)"/>
                    <TextBlock Text="Advantage with a landmark in sight · auto success following the river, a waymarker or a guide"
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AdjacentText}" FontSize="14" TextWrapping="Wrap" Margin="0 2 0 0"/>
                    <TextBlock Text="{Binding SpecialText}" FontSize="14" TextWrapping="Wrap" Margin="0 2 0 0"/>
                    <CheckBox Content="Name shown to players"
                              IsChecked="{Binding IsPartyHexNameRevealed}"
                              Visibility="{Binding CanRevealName, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"
                              ToolTip="Reveal or hide the name of the hex the party stands on"
                              Margin="0 4 0 0"/>
                    <Border Margin="0 4 0 0" Padding="4" BorderThickness="1" BorderBrush="LightGray" Background="#FFF8F8F0"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
                        <TextBlock Text="{Binding NotesText}" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!--History of completed days (route only), newest first-->
        <Separator Margin="0 4 0 4"/>
        <Expander IsExpanded="False" DataContext="{Binding Tracker}">
            <Expander.Header>
                <TextBlock Text="History" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel Margin="4 4 0 4">
                <TextBlock Text="No completed days yet" Foreground="Gray" FontSize="13"
                           Visibility="{Binding HasHistory, Converter={StaticResource InvertedBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"/>
                <ItemsControl ItemsSource="{Binding HistoryLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Margin="0 2 0 0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

    </StackPanel>
    </ScrollViewer>
</UserControl>
