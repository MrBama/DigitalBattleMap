<UserControl x:Class="DigitalBattleMap.Views.HexcrawlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="480"
             Background="White"
             FontSize="17">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--Tile list-->
        <ListView ItemsSource="{Binding TileList}"
                  SelectedItem="{Binding SelectedTile}"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Colour/image preview-->
                        <Border Width="28" Height="28" Margin="0 2 6 2"
                                Background="{Binding PreviewBrush}"
                                BorderThickness="1" BorderBrush="Gray"
                                ClipToBounds="True">
                            <Border.Clip>
                                <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                            </Border.Clip>
                        </Border>
                        <Label Grid.Column="1" Content="{Binding Name}" VerticalContentAlignment="Center" Padding="0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--Tile buttons-->
        <Grid Grid.Row="1" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add tile"    Margin="0 0 4 0" Command="{Binding AddTileCommand}"/>
            <Button Content="Remove tile" Grid.Column="1" Margin="4 0 0 0" Command="{Binding RemoveTileCommand}"/>
        </Grid>

        <!--Rename-->
        <Grid Grid.Row="2" Margin="0 6 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0 0 4 0"/>
            <Button Grid.Column="1" Content="Rename" Command="{Binding RenameTileCommand}" MinWidth="80"/>
        </Grid>

        <!--Grid size-->
        <Grid Grid.Row="3" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="W:" VerticalContentAlignment="Center" Padding="0 0 4 0"/>
            <TextBox Grid.Column="1" Text="{Binding Map.GridWidth, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
            <Label Grid.Column="2" Content="H:" VerticalContentAlignment="Center" Padding="8 0 4 0"/>
            <TextBox Grid.Column="3" Text="{Binding Map.GridHeight, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
        </Grid>

        <!--Undo / Redo-->
        <Grid Grid.Row="4" Margin="0 6 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Undo" Margin="0 0 4 0" Command="{Binding UndoCommand}"
                    IsEnabled="{Binding Map.PaintHistory.IsPreviousCommandAvailable}"/>
            <Button Content="Redo" Grid.Column="1" Margin="4 0 0 0" Command="{Binding RedoCommand}"
                    IsEnabled="{Binding Map.PaintHistory.IsNextCommandAvailable}"/>
        </Grid>
        <!--Place name: right-click a hex to select it, then type the name-->
        <Grid Grid.Row="5" Margin="0 8 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Place name (right-click hex to select)"
                       FontSize="13" Foreground="Gray"/>
            <Grid Grid.Row="1" Margin="0 2 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Map.SelectedHexInfo}"
                           VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14"
                           Margin="0 0 6 0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Map.SelectedCellLabel, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <!--Separator-->
        <Separator Grid.Row="6" Margin="0 8 0 0"/>

        <!--Edge features header-->
        <TextBlock Grid.Row="7" Text="Edge Features" FontWeight="SemiBold" Margin="0 4 0 2"/>

        <!--Edge type list-->
        <ListView Grid.Row="8"
                  ItemsSource="{Binding EdgeTypeList}"
                  SelectedItem="{Binding SelectedEdgeType}"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="10" Margin="0 2 6 2"
                                Background="{Binding PreviewBrush}"
                                BorderThickness="1" BorderBrush="Gray"
                                CornerRadius="3"/>
                        <Label Grid.Column="1" Content="{Binding Name}" VerticalContentAlignment="Center" Padding="0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--Edge add / remove-->
        <Grid Grid.Row="9" Margin="0 6 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add edge"    Margin="0 0 4 0" Command="{Binding AddEdgeTypeCommand}"/>
            <Button Content="Remove edge" Grid.Column="1" Margin="4 0 0 0" Command="{Binding RemoveEdgeTypeCommand}"/>
        </Grid>

        <!--Edge rename-->
        <Grid Grid.Row="10" Margin="0 4 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding EditingEdgeName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0 0 4 0"/>
            <Button Grid.Column="1" Content="Rename" Command="{Binding RenameEdgeTypeCommand}" MinWidth="80"/>
        </Grid>

        <!--Edge smooth curves toggle-->
        <CheckBox Grid.Row="12" Margin="0 6 0 0"
                  Content="Smooth curves"
                  IsChecked="{Binding EditingEdgeCurved}"/>

        <!--Edge color (#RRGGBB)-->
        <Grid Grid.Row="11" Margin="0 4 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" Margin="0 0 6 0"
                    Background="{Binding SelectedEdgeType.PreviewBrush}"
                    BorderThickness="1" BorderBrush="Gray"
                    CornerRadius="2"/>
            <TextBox Grid.Column="1"
                     Text="{Binding EditingEdgeColor, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0 0 4 0"
                     FontFamily="Consolas"/>
            <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyEdgeColorCommand}" MinWidth="60"/>
        </Grid>

    </Grid>
</UserControl>
