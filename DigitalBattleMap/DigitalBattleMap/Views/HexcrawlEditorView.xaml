<UserControl x:Class="DigitalBattleMap.Views.HexcrawlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dataClasses="clr-namespace:DigitalBattleMap.DataClasses"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="480"
             Background="White"
             FontSize="17">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--Tile list-->
        <ListView ItemsSource="{Binding TileList}"
                  SelectedItem="{Binding SelectedTile}"
                  HorizontalContentAlignment="Stretch"
                  ToolTip="Click the selected tile again to deselect it and erase painted tiles">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Colour/image preview-->
                        <Border Width="28" Height="28" Margin="0 2 6 2"
                                Background="{Binding PreviewBrush}"
                                BorderThickness="1" BorderBrush="Gray"
                                ClipToBounds="True">
                            <Border.Clip>
                                <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                            </Border.Clip>
                        </Border>
                        <Label Grid.Column="1" Content="{Binding Name}" VerticalContentAlignment="Center" Padding="0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--Tile buttons-->
        <Grid Grid.Row="1" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add tile"    Margin="0 0 4 0" Command="{Binding AddTileCommand}"/>
            <Button Content="Remove tile" Grid.Column="1" Margin="4 0 0 0" Command="{Binding RemoveTileCommand}"/>
        </Grid>

        <!--Tile settings: name + terrain rules used by the play tab tracker-->
        <Grid Grid.Row="2" Margin="0 6 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Label Content="Name" VerticalContentAlignment="Center" Padding="0 0 6 0"/>
            <TextBox Grid.Column="1" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0 0 4 0"/>
            <Button Grid.Column="2" Content="Change image" Command="{Binding ChangeTileImageCommand}"
                    ToolTip="Replace the image of this tile; painted hexes keep using it"/>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0 4 0 0">
                <Label Content="Hours" VerticalContentAlignment="Center" Padding="0 0 6 0"
                       ToolTip="Exploring hours spent when the party enters a hex of this terrain (named hexes always take 1 hour)"/>
                <TextBox Text="{Binding EditingTravelHours, UpdateSourceTrigger=PropertyChanged}"
                         Width="45" VerticalContentAlignment="Center" Margin="0 0 10 0"/>
                <Label Content="Encounter on d6 ≥" VerticalContentAlignment="Center" Padding="0 0 6 0"
                       ToolTip="Morning encounter triggers on this d6 result or higher when the day starts here"/>
                <ComboBox ItemsSource="{Binding EncounterOnOptions}" SelectedItem="{Binding EditingEncounterOn}" Width="50"/>
            </StackPanel>

            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0 4 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="Needs navigation check" VerticalAlignment="Center"
                          IsChecked="{Binding EditingRequiresNavigation}"/>
                <Button Grid.Column="1" Content="Save tile" Command="{Binding SaveTileCommand}" MinWidth="80"/>
            </Grid>
        </Grid>

        <!--Grid size-->
        <Grid Grid.Row="3" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="W:" VerticalContentAlignment="Center" Padding="0 0 4 0"/>
            <TextBox Grid.Column="1" Text="{Binding Map.GridWidth, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
            <Label Grid.Column="2" Content="H:" VerticalContentAlignment="Center" Padding="8 0 4 0"/>
            <TextBox Grid.Column="3" Text="{Binding Map.GridHeight, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
        </Grid>

        <!--Undo / Redo-->
        <Grid Grid.Row="4" Margin="0 6 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Undo" Margin="0 0 4 0" Command="{Binding UndoCommand}"
                    IsEnabled="{Binding Map.PaintHistory.IsPreviousCommandAvailable}"/>
            <Button Content="Redo" Grid.Column="1" Margin="4 0 0 0" Command="{Binding RedoCommand}"
                    IsEnabled="{Binding Map.PaintHistory.IsNextCommandAvailable}"/>
        </Grid>
        <!--Place name: right-click a hex to select it, then type the name-->
        <Grid Grid.Row="5" Margin="0 8 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Selected hex (right-click a hex). A place name makes it searchable, 1 h to enter"
                       TextWrapping="Wrap"
                       FontSize="13" Foreground="Gray"/>
            <Grid Grid.Row="1" Margin="0 2 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Map.SelectedHexInfo}"
                           VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14"
                           Margin="0 0 6 0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Map.SelectedCellLabel, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <!--DM-only info for the selected hex-->
            <StackPanel Grid.Row="2" Margin="0 4 0 0" IsEnabled="{Binding Map.HasSelectedHex}">
                <ComboBox Width="150" HorizontalAlignment="Left"
                          SelectedValue="{Binding Map.SelectedHexSpecial}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="Normal hex" Tag="{x:Static dataClasses:HexSpecial.None}"/>
                    <ComboBoxItem Content="Point of interest" Tag="{x:Static dataClasses:HexSpecial.PointOfInterest}"/>
                    <ComboBoxItem Content="Dungeon" Tag="{x:Static dataClasses:HexSpecial.Dungeon}"/>
                </ComboBox>
                <TextBox Margin="0 4 0 0" MinHeight="50" MaxHeight="110"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontSize="14"
                         ToolTip="DM notes for this hex (shown in the play tab, never to players)"
                         Text="{Binding Map.SelectedHexNotes, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!--Separator-->
        <Separator Grid.Row="6" Margin="0 8 0 0"/>

        <!--Edge features header-->
        <TextBlock Grid.Row="7" Text="Edge Features" FontWeight="SemiBold" Margin="0 4 0 2"/>

        <!--Edge type list-->
        <ListView Grid.Row="8"
                  ItemsSource="{Binding EdgeTypeList}"
                  SelectedItem="{Binding SelectedEdgeType}"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="10" Margin="0 2 6 2"
                                Background="{Binding PreviewBrush}"
                                BorderThickness="1" BorderBrush="Gray"
                                CornerRadius="3"/>
                        <Label Grid.Column="1" Content="{Binding Name}" VerticalContentAlignment="Center" Padding="0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--Edge add / remove-->
        <Grid Grid.Row="9" Margin="0 6 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add edge"    Margin="0 0 4 0" Command="{Binding AddEdgeTypeCommand}"/>
            <Button Content="Remove edge" Grid.Column="1" Margin="4 0 0 0" Command="{Binding RemoveEdgeTypeCommand}"/>
        </Grid>

        <!--Edge rename-->
        <Grid Grid.Row="10" Margin="0 4 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding EditingEdgeName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0 0 4 0"/>
            <Button Grid.Column="1" Content="Rename" Command="{Binding RenameEdgeTypeCommand}" MinWidth="80"/>
        </Grid>

        <!--Edge smooth curves toggle-->
        <CheckBox Grid.Row="12" Margin="0 6 0 0"
                  Content="Smooth curves"
                  IsChecked="{Binding EditingEdgeCurved}"/>

        <!--Edge color (#RRGGBB)-->
        <Grid Grid.Row="11" Margin="0 4 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" Margin="0 0 6 0"
                    Background="{Binding SelectedEdgeType.PreviewBrush}"
                    BorderThickness="1" BorderBrush="Gray"
                    CornerRadius="2"/>
            <TextBox Grid.Column="1"
                     Text="{Binding EditingEdgeColor, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0 0 4 0"
                     FontFamily="Consolas"/>
            <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyEdgeColorCommand}" MinWidth="60"/>
        </Grid>

    </Grid>
</UserControl>
